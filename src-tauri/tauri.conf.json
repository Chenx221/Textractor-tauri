{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "textractor-tauri",
  "version": "0.1.0",
  "identifier": "cyou.chenx221.textractor-tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Textractor",
        "width": 1100,
        "height": 850,
        "transparent": true
      },
      {
        "label": "extra",
        "title": "Textractor Extra",
        "width": 680,
        "height": 240,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "maximizable": false,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "TradChinese",
          "English",
          "Japanese",
          "Korean",
          "French",
          "German",
          "Spanish",
          "SpanishInternational",
          "Russian",
          "Italian",
          "Portuguese",
          "PortugueseBR",
          "Dutch",
          "Turkish",
          "Arabic",
          "Vietnamese",
          "Ukrainian",
          "Bulgarian",
          "Swedish",
          "Norwegian"
        ],
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Chenx221/Textractor-tauri/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2OUQ1ODg5RjJGRDA3QTUKUldTbEIvM3lpVmlkWnRXdU5pY3QzWmswc2NUSXBFRVFtYTcwcFoyWGZpOGRLQWUrOXlaMlJBNjIK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
